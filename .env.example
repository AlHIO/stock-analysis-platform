# Local development placeholders only. Replace before deploying outside your machine.
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=stockapp
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Host URLs for running Python/Next.js outside Docker; Compose overrides service hosts.
DATABASE_URL=postgresql://stockapp:local_dev_only@localhost:5432/stockapp
REDIS_URL=redis://localhost:6379/0
BACKEND_URL=http://localhost:8000

# Conservative project defaults, not official provider quotas.
INGESTION_MIN_INTERVAL_SECONDS=5
INGESTION_MAX_ATTEMPTS=3
INGESTION_MAX_RESPONSE_BYTES=20000000

# Optional: UUID returned by stockapp history plan; used only by the history profile.
HISTORY_JOB_ID=
# Optional: ordered, comma-separated UUIDs; takes precedence over HISTORY_JOB_ID.
# Runs only these explicitly planned jobs, stopping on unfinished/failed work.
HISTORY_JOB_IDS=
